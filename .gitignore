.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local database password for compose (see .env.example)
.env

# Local Supabase credentials for `docker compose --env-file supabase.env ...`
supabase.env

# Generated by `indexer export`; published to the output branch, not committed here
output/
# publish.yml's checkout of the posts branch (`indexer export --posts-dir posts`)
posts/
posts.git/
# Written by `indexer cleanup --report` in cleanup.yml
report/
# Written by `indexer clusters`; kept on the binaries branch, not here (clusters.yml)
data/clusters/posts.*
# A checkout of the proposals branch (its data/proposals/ is mounted as data/proposals/), and
# that mount point
/proposals/
/data/proposals/
# clusters.yml's checkout of the posts branch
published/
# The proposal filter `indexer proposals` trains and keeps (training.cached_model); never commit models
data/models/
